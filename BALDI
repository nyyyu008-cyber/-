-- ระบบวาร์ปเก็บสมุดตามจำนวนที่ระบุ (รองรับสูงสุด 14 เล่ม)
collectBtn.MouseButton1Click:Connect(function()
    local targetCount = math.clamp(tonumber(bookInput.Text) or 14, 1, 14)
    local collected = 0
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    for _, item in ipairs(Workspace:GetDescendants()) do
        if collected >= targetCount then break end
        
        local isNotebook = false
        local itemName = string.lower(item.Name)
        if string.find(itemName, "notebook") or string.find(itemName, "book") or item.Name == "Red" or item.Name == "Blue" or item.Name == "Yellow" then
            isNotebook = true
        end

        if isNotebook then
            local partToTouch = item:IsA("BasePart") and item or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildOfClass("BasePart")))
            if partToTouch and hrp then
                hrp.CFrame = partToTouch.CFrame
                task.wait(0.08)
                if firetouchinterest then
                    firetouchinterest(hrp, partToTouch, 0)
                    firetouchinterest(hrp, partToTouch, 1)
                end
                local cd = partToTouch:FindFirstChildOfClass("ClickDetector") or item:FindFirstChildOfClass("ClickDetector")
                if cd and fireclickdetector then
                    fireclickdetector(cd)
                end
                collected = collected + 1
            end
        end
    end

    -- ปรับตัวเลขจำนวนสมุดใน Leaderstats
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if string.find(string.lower(stat.Name), "notebook") or string.find(string.lower(stat.Name), "book") then
                stat.Value = targetCount
            end
        end
    end
end)

