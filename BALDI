-- -------------------------------------------------------------
-- Master Engine Loop
-- -------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        if hum then
            hum.WalkSpeed = States.WalkSpeed
            hum.JumpPower = States.JumpPower
        end

        -- 1. God Mode (แช่แข็ง Baldi & ครูใหญ่)
        if States.GodMode then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanTouch = false end
            end
            for _, monster in ipairs(Workspace:GetDescendants()) do
                local name = string.lower(monster.Name)
                if string.find(name, "baldi") or string.find(name, "principal") then
                    if monster:IsA("Model") and monster.PrimaryPart then
                        monster.PrimaryPart.Anchored = true
                    elseif monster:IsA("BasePart") then
                        monster.Anchored = true
                        monster.CanTouch = false
                    end
                end
            end
        end

        -- 2. Anti-Bully
        if States.AntiBully then
            for _, npc in ipairs(Workspace:GetDescendants()) do
                if string.find(string.lower(npc.Name), "bully") then
                    if npc:IsA("Model") and npc.PrimaryPart then
                        npc:SetPrimaryPartCFrame(CFrame.new(0, -1000, 0))
                    elseif npc:IsA("BasePart") then
                        npc.CanCollide = false
                        npc.Transparency = 1
                    end
                end
            end
        end

        -- 3. Infinite Stamina
        if States.InfiniteStamina then
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            if pGui then
                for _, stat in ipairs(pGui:GetDescendants()) do
                    if string.find(string.lower(stat.Name), "stamina") then
                        if stat:IsA("ValueBase") then
                            stat.Value = 100
                        end
                    end
                end
            end
        end

        -- 4. Infinite Items
        if States.InfiniteItems then
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                for _, tool in ipairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        tool.CanBeDropped = false
                    end
                end
            end
        end

        -- 5. Auto Skip Question 3 (ปิดหรือข้ามหน้าสมุดทันทีเมื่อเจอข้อ 3)
        if States.AutoSkipQ3 then
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            if pGui then
                for _, gui in ipairs(pGui:GetChildren()) do
                    if string.find(string.lower(gui.Name), "math") or string.find(string.lower(gui.Name), "notebook") then
                        gui.Enabled = false -- ปิดหน้าต่างโจทย์คณิตข้ามข้อทันที
                    end
                end
            end
        end

        -- 6. Noclip
        if States.Noclip then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end

    -- Book ESP
    if States.ESPBooks then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local itemName = string.lower(obj.Name)
            if string.find(itemName, "notebook") or string.find(itemName, "book") or obj.Name == "Red" or obj.Name == "Blue" or obj.Name == "Yellow" then
                if (obj:IsA("BasePart") or obj:IsA("Model")) and not obj:FindFirstChild("BookESP") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "BookESP"
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.3
                    highlight.Parent = obj

                    local bgui = Instance.new("BillboardGui")
                    bgui.Name = "BookTag"
                    bgui.AlwaysOnTop = true
                    bgui.Size = UDim2.new(0, 100, 0, 30)
                    bgui.StudsOffset = Vector3.new(0, 2, 0)
                    bgui.Parent = obj

                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = "📖 Notebook"
                    lbl.TextColor3 = Color3.fromRGB(255, 255, 0)
                    lbl.TextStrokeTransparency = 0
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 12
                    lbl.Parent = bgui
                end
            end
        end
    end
end)

